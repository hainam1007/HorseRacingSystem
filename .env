# Compose-level env (read by docker-compose.yml).
# Real secrets should come from .env.local or shell env in production.

POSTGRES_DB=horse_racing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_HOST_PORT=5433

BACKEND_HOST_PORT=3000

# Required: set these before `docker compose up`. The compose file fails fast if
# JWT_SECRET or INTERNAL_API_TOKEN are empty.
JWT_SECRET=change_me_to_a_long_random_secret
INTERNAL_API_TOKEN=change_me_to_a_long_random_internal_token

# Optional integrations (leave blank if not used).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh
VND_PER_TOKEN=1000

EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_REDIRECT_URL=http://localhost:3000/payment-success
MOMO_IPN_URL=http://localhost:3000/api/deposit/webhook/payment

VNPAY_TMN_CODE=SLEH6JQ9
VNPAY_HASH_SECRET=3SWP8N2WE5GGZC3OET2ZLQL8615P38N4
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/deposit/webhook/payment
FRONTEND_PAYMENT_RETURN_URL=http://localhost:5173/payment-success

MOCK_PAYMENT_WEBHOOK_SECRET=SUPER_SECURE_MOCK_SECRET_12345

PROBABILITY_ENGINE_MODE=http
PROBABILITY_ENGINE_URL=https://son2110-horse-racing-probability-engine.hf.space/predict
PROBABILITY_ENGINE_PYTHON=python

# Auto-apply 001_init_postgres.sql on first boot (idempotent — skipped if DB already initialised).
DB_AUTO_APPLY_SCHEMA=false