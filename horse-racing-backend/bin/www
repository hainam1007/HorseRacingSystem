#!/usr/bin/env node

// Load .env WITHOUT overriding values that are already set in the environment.
// In Docker, PGHOST/PGUSER/etc. are injected by compose and must win over the
// developer's local .env file (which is not even shipped in the image).
const dotenv = require("dotenv");
const result = dotenv.config({ override: false });

if (process.env.NODE_ENV !== "production") {
  console.log("================= BOOTSTRAP ENV CHECK =================");

  if (result.error) {
    console.error("⚠️ Không tìm thấy file .env", result.error.message);
  } else {
    console.log("✅ Đã nạp file .env thành công!");
    console.log(
      "➜ MOMO_SECRET_KEY:",
      process.env.MOMO_SECRET_KEY ? "Đã nạp" : "Bị thiếu"
    );
    console.log(
      "➜ VNPAY_TMN_CODE:",
      process.env.VNPAY_TMN_CODE ? "Đã nạp" : "Bị thiếu"
    );
  }

  console.log("=======================================================");
}

// Re-load to silence dotenv's "injected env" log without overriding anything.
require("dotenv").config({ override: false, quiet: true });

const app = require("../app");
const debug = require("debug")("horse-racing:server");
const http = require("http");

/**
 * Application runtime — PostgreSQL/Sequelize only.
 *
 * The legacy dual-mode driver switch was removed. The server always
 * initializes Sequelize at boot.
 */

const port = normalizePort(process.env.PORT || "3000");
app.set("port", port);

const server = http.createServer(app);

startServer();

async function startServer() {
  try {
    const { loadSequelizeModels } = require("../models/sequelize/index.js");
    const { sequelize } = loadSequelizeModels();
    await sequelize.authenticate();
    console.log("[sequelize] connected — storage driver = postgres");
    server.listen(port);
    server.on("error", onError);
    server.on("listening", onListening);
  } catch (error) {
    console.error("Failed to start server:", error.message);
    process.exit(1);
  }
}

/**
 * Normalize a port into a number, string, or false.
 */
function normalizePort(val) {
  const port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */
function onError(error) {
  if (error.syscall !== "listen") {
    throw error;
  }

  const bind = typeof port === "string" ? "Pipe " + port : "Port " + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case "EACCES":
      console.error(bind + " requires elevated privileges");
      process.exit(1);
      break;
    case "EADDRINUSE":
      console.error(bind + " is already in use");
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */
function onListening() {
  const addr = server.address();
  const bind = typeof addr === "string" ? "pipe " + addr : "port " + addr.port;
  debug("Listening on " + bind);
}
