NODE_ENV=development
PORT=3000

# ==========================================
# 🟠 POSTGRESQL (DB driver — runtime uses Postgres only)
# ==========================================
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me_to_your_postgres_password
PGDATABASE=horse_racing
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=30000

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
EMAIL_VERIFICATION_TOKEN_EXPIRES_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=15
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Comma-separated frontend origins. Localhost ports are allowed automatically in development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Exchange rate: VND per 1 Token (default: 1000)
VND_PER_TOKEN=1000
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=your_gmail_address@gmail.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
INTERNAL_API_TOKEN=change_me_to_a_long_random_internal_token
# Optional: set only in tests when reproducible demo results are required.
RACE_ENGINE_RANDOM_SEED=
# Probability engine mode:
# - local: run app_probability_engine_history_v1_runtime with Python on this machine.
# - http: call deployed model API at PROBABILITY_ENGINE_URL.
PROBABILITY_ENGINE_MODE=local
PROBABILITY_ENGINE_URL=
# Optional: Python executable for local probability engine mode.
PROBABILITY_ENGINE_PYTHON=python
PROBABILITY_ENGINE_TIMEOUT_MS=30000


