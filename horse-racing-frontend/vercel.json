{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://horse-racing-backend-tplt.onrender.com/api/:path*"
    },
    {
      "source": "/users/:path*",
      "destination": "https://horse-racing-backend-tplt.onrender.com/users/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
